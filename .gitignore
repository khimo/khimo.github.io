# Ignore Vim swap files
*.swp
*.swo

# Ignore Vim backup files
*.bak
*.tmp

# Ignore Emacs temporary files
*~
\#*\#

# Embeddings build step: transformers package lives in a docker named volume;
# this dir is only an empty bind-mount point on the host.
node_modules/


# Jekyll build output + caches (generated; never commit)
_site/
.jekyll-cache/
.jekyll-metadata
.sass-cache/
vendor/bundle/

# Downloaded Pagefind binary (runs via npx/Docker; not source)
bin/pagefind
